import java.util.Scanner;

public class BuscaDeNomes {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        String[] nomes = new String[6];
        for (int i = 0; i < nomes.length; i++) {
            System.out.printf("Digite o %d° nome: %n", i+1);
            nomes[i] = sc.next();
        }

        System.out.printf("Buscar qual nome? %n");
        String busca = sc.next();

        int contador = 0;
        for (int i = 0; i < nomes.length; i++) {
            if (nomes[i].equalsIgnoreCase(busca)) {
                System.out.println("Encontrado na posição " + i);
                contador++;
            }
        }

        if (contador == 0) {
            System.out.println(busca + " não foi encontrado.");
        } else {
            System.out.println(busca + " aparece " + contador + " vez(es).");
        }

        sc.close();
    }
}
